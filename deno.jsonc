{
	"nodeModulesDir": "auto",
	"unstable": ["sloppy-imports"],
	"tasks": {
		"dev": {
			"command": "deno run -A npm:vite dev --host",
			"dependencies": ["db-bootstrap"]
		},
		"build": "deno run --allow-env --allow-read --allow-write --allow-run ./src/scripts/build.ts",
		"serve": {
			"command": "deno run --allow-read --allow-env --allow-write --allow-net ./src/scripts/serve.ts",
			"dependencies": ["build"]
		},

		"db-bootstrap": "deno run --allow-read --allow-env --allow-write --allow-run ./src/scripts/db-bootstrap.ts",

		"fmt": "deno run --allow-env --allow-read --allow-write --allow-run npm:@biomejs/biome check --write --unsafe --assists-enabled=true .",
		"typegen": "deno run -A ./node_modules/.bin/react-router typegen",
		"typecheck": {
			"command": "deno check ./src",
			"dependencies": ["typegen"]
		}
	},
	"imports": {
		// Path aliases
		"$api": "./src/api/index.ts",
		"$api/": "./src/api/",
		"$db": "./src/database/index.ts",
		"$db/": "./src/database/",
		"@std/http": "jsr:@std/http@^1.0.14",
		"@std/path": "jsr:@std/path@^1.0.8",
		"~/": "./src/app/",

		// Dependencies
		"@david/dax": "jsr:@david/dax@^0.42.0",
		"@react-router/fs-routes": "npm:@react-router/fs-routes@^7.5.1",
		"@react-router/node": "npm:@react-router/node@^7.5.1",
		"@std/assert": "jsr:@std/assert@^1.0.12",
		"drizzle-kit": "npm:drizzle-kit@^0.31.0",
		"drizzle-orm": "npm:drizzle-orm@^0.42.0",
		"hono": "npm:hono@^4.7.7",
		"isbot": "npm:isbot@^5",
		"react": "npm:react@^19.1.0",
		"react-dom": "npm:react-dom@^19.1.0",
		"react-router": "npm:react-router@^7.5.1",

		// Dev Depencencies
		"@biomejs/biome": "npm:@biomejs/biome@^1.9.4",
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.4",
		"@react-router/dev": "npm:@react-router/dev@^7.5.1",
		"@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.4",
		"@types/node": "npm:@types/node@^22.14.0",
		"@types/react": "npm:@types/react@^19.1.2",
		"@types/react-dom": "npm:@types/react-dom@^19.1.0",
		"@std/cli": "jsr:@std/cli@^1.0.16",
		"better-sqlite3": "npm:better-sqlite3@^11.9.1",
		"tailwindcss": "npm:tailwindcss@^4.1.4",
		"vite": "npm:vite@^6.3.1"
	},
	"compilerOptions": {
		"strict": true,
		"lib": ["Deno.NS", "DOM", "DOM.Iterable", "ES2022"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"rootDirs": [".", "./.react-router/types"],
		"checkJs": true,
		"verbatimModuleSyntax": true
	},
	// Disable Deno Lint/Fmt; use Biome instead
	"lint": { "exclude": ["**/*"] },
	"fmt": { "exclude": ["**/*"] }
}
