{
	"nodeModulesDir": "auto",
	"tasks": {
		// FIXME: Failed resolving binary export. './node_modules/.deno/react-router@7.5.0/node_modules/react-router/package.json' did not have a bin property
		// FIXME: Need a package.json to detect runtime; should be able to do it by the presence of deno.json (or from deno.json's "imports")
		"dev": "deno task db:bootstrap && deno run -A ./node_modules/.bin/react-router dev --host",
		"build": "deno run -A ./src/scripts/build.ts",
		"start": "deno run -A ./src/scripts/start.ts",
		"db:gui": "deno run -A npm:drizzle-kit studio",
		"db:bootstrap": "deno run -A ./src/scripts/db.bootstrap.ts",
		"db:generate": "deno run -A npm:drizzle-kit generate",
		"db:migrate": "deno run -A npm:drizzle-kit migrate",
		"check": "deno run -A npm:@biomejs/biome check --write --unsafe --assists-enabled=true .",
		"fmt": "deno run -A npm:@biomejs/biome format --write .",
		"lint": "deno run -A npm:@biomejs/biome lint --write --unsafe .",
		"typecheck": "deno run -A ./node_modules/.bin/react-router typegen && deno run -A npm:tsc"
	},
	"imports": {
		// Path aliases
		"~/database/": "./src/database/",
		"~/": "./src/app/",

		// Dependencies
		"@david/dax": "jsr:@david/dax@^0.42.0",
		// "@libsql/client": "npm:@libsql/client@^0.15.2",
		"@react-router/fs-routes": "npm:@react-router/fs-routes@^7.5.0",
		"@react-router/node": "npm:@react-router/node@^7.5.0",
		"@std/assert": "jsr:@std/assert@^1.0.12",
		// "better-sqlite3": "npm:better-sqlite3@^11.9.1",
		"drizzle-kit": "npm:drizzle-kit@^0.30.1",
		"drizzle-orm": "npm:drizzle-orm@~0.36.3",
		"hono": "npm:hono@^4.7.6",
		"isbot": "npm:isbot@^5.1.17",
		"react": "npm:react@^19.1.0",
		"react-dom": "npm:react-dom@^19.1.0",
		"react-router": "npm:react-router@^7.5.0",
		"remix-hono": "npm:remix-hono@^0.0.18",

		// Dev Depencencies
		"@biomejs/biome": "npm:@biomejs/biome@^1.9.4",
		"@hono/vite-dev-server": "npm:@hono/vite-dev-server@^0.19.0",
		"@react-router/dev": "npm:@react-router/dev@^7.5.0",
		"@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.3",
		"@types/node": "npm:@types/node@^22.14.0",
		"@types/react": "npm:@types/react@^19.1.0",
		"@types/react-dom": "npm:@types/react-dom@^19.1.0",
		"oxc-transform": "npm:oxc-transform@^0.42.0",
		"tailwindcss": "npm:tailwindcss@^4.1.3",
		"vite": "npm:vite@^6.2.6",
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.4"
	},
	"compilerOptions": {
		"strict": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022", "Deno.NS", "Deno.Unstable"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"rootDirs": [".", "./.react-router/types"],
		"checkJs": true,
		"verbatimModuleSyntax": true
	},
	"unstable": ["kv"],
	// Use Biome instead of Deno Lint/Fmt
	"lint": { "exclude": ["**/*"] },
	"fmt": { "exclude": ["**/*"] }
}
