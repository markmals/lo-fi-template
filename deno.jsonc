{
	"$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
	"nodeModulesDir": "auto",
	"unstable": ["kv", "sloppy-imports"],
	"tasks": {
		"dev": {
			"command": "deno run -A npm:vite dev --host",
			"dependencies": ["db-bootstrap"]
		},
		"build": "deno run -A ./src/scripts/build.ts",
		"serve": {
			"command": "deno run -A ./src/scripts/serve.ts",
			"dependencies": ["build"]
		},

		"db-bootstrap": "deno run -A ./src/scripts/db-bootstrap.ts",

		"fmt": "deno run -A ./node_modules/.bin/biome check --write --unsafe --assist-enabled=true .",
		"typegen": "deno run -A ./node_modules/.bin/react-router typegen",
		"typecheck": {
			"command": "deno check ./src",
			"dependencies": ["typegen"]
		}
	},
	"imports": {
		// Path aliases
		"$api": "./src/api/index.ts",
		"$api/": "./src/api/",
		"$db": "./src/database/index.ts",
		"$db/": "./src/database/",
		"@std/jsonc": "jsr:@std/jsonc@^1.0.2",
		"~/": "./src/app/",

		// Dependencies
		"@david/dax": "jsr:@david/dax@^0.42.0",
		"@react-router/fs-routes": "npm:@react-router/fs-routes@^7.6.0",
		"@react-router/node": "npm:@react-router/node@^7.6.0",
		"@std/assert": "jsr:@std/assert@^1.0.12",
		"@std/http": "jsr:@std/http@^1.0.14",
		"@std/path": "jsr:@std/path@^1.0.8",
		"drizzle-kit": "npm:drizzle-kit@^0.30.1",
		"drizzle-orm": "npm:drizzle-orm@~0.36.3",
		"hono": "npm:hono@^4.7.6",
		"isbot": "npm:isbot@^5",
		"react": "npm:react@^19.1.0",
		"react-dom": "npm:react-dom@^19.1.0",
		"react-router": "npm:react-router@^7.6.0",
		"@biomejs/biome": "npm:@biomejs/biome@^2.0.0-beta.3",
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.4",
		"@react-router/dev": "npm:@react-router/dev@^7.6.0",
		"@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.3",
		"@types/node": "npm:@types/node@^22.14.0",
		"@types/react": "npm:@types/react@^19.1.0",
		"@types/react-dom": "npm:@types/react-dom@^19.1.0",
		"@std/cli": "jsr:@std/cli@^1.0.16",
		"better-sqlite3": "npm:better-sqlite3@^11.9.1",
		"tailwindcss": "npm:tailwindcss@^4.1.3",
		"vite": "npm:vite@^6.2.6"
	},
	"compilerOptions": {
		"strict": true,
		"lib": ["Deno.NS", "Deno.Unstable", "DOM", "DOM.Iterable", "ES2022"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"rootDirs": [".", "./.react-router/types"],
		"checkJs": true,
		"verbatimModuleSyntax": true
	},
	// Disable Deno Lint/Fmt; use Biome instead
	"lint": { "exclude": ["**/*"] },
	"fmt": { "exclude": ["**/*"] }
}
